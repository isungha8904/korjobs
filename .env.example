# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)
# 주의: 값 뒤에 인라인 주석을 달지 마세요 — 빈 값 뒤의 주석은 값으로 읽힙니다.

# Discord 개발자 포털 > Bot > Reset Token
DISCORD_BOT_TOKEN=여기에_붙여넣기

# 비공개 승인 채널 ID (디스코드 개발자 모드 켜고 채널 우클릭 > ID 복사)
APPROVAL_CHANNEL_ID=123456789012345678

# 공지(발송 대상) 채널 ID
ANNOUNCE_CHANNEL_ID=123456789012345678

# 선택: 승인 가능 유저 ID를 콤마로 구분. 비우면 승인 채널 멤버 전원 허용
APPROVER_IDS=
